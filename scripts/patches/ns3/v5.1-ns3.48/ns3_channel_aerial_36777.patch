+ */
+
+#include "ns3/boolean.h"
+#include "ns3/constant-position-mobility-model.h"
+#include "ns3/double.h"
+#include "ns3/log.h"
+#include "ns3/node-container.h"
+#include "ns3/simulator.h"
+#include "ns3/string.h"
+#include "ns3/test.h"
+#include "ns3/three-gpp-aerial-propagation-loss-model.h"
+#include "ns3/three-gpp-propagation-loss-model.h"
+
+using namespace ns3;
+
+/**
+ * TR 36.777 Annex B breakpoints, including the height clamp.
+ */
+class ThreeGppAerialPropagationLossTestCase : public TestCase
+{
+  public:
+    ThreeGppAerialPropagationLossTestCase()
+        : TestCase("TR 36.777 aerial path loss and LOS probability")
+    {
+    }
+
+  private:
+    void DoRun() override
+    {
+        NodeContainer nodes;
+        nodes.Create(2);
+        Ptr<MobilityModel> bs = CreateObject<ConstantPositionMobilityModel>();
+        Ptr<MobilityModel> ue = CreateObject<ConstantPositionMobilityModel>();
+        nodes.Get(0)->AggregateObject(bs);
+        nodes.Get(1)->AggregateObject(ue);
+
+        Ptr<ThreeGppAerialPropagationLossModel> loss =
+            CreateObject<ThreeGppAerialPropagationLossModel>();
+        loss->SetAttribute("ShadowingEnabled", BooleanValue(false));
+        loss->SetAttribute("Frequency", DoubleValue(2.0e9));
+        loss->SetChannelConditionModel(CreateObject<AlwaysLosChannelConditionModel>());
+
+        // UMa-AV, h_UT = 100 m, d_2D = 500 m, h_BS = 25 m, f_c = 2 GHz.
+        // PL = 28 + 22*log10(d_3D) + 20*log10(f_c) = 93.5042364921 dB.
+        bs->SetPosition(Vector(0.0, 0.0, 25.0));
+        ue->SetPosition(Vector(500.0, 0.0, 100.0));
+        NS_TEST_EXPECT_MSG_EQ_TOL(loss->CalcRxPower(0.0, bs, ue),
+                                  -93.5042364921,
+                                  0.1,
+                                  "UMa-AV LOS at 100 m / 500 m");
+
+        loss->SetChannelConditionModel(CreateObject<NeverLosChannelConditionModel>());
+        ue->SetPosition(Vector(500.0, 0.0, 50.0));
+        // UMa-AV NLOS at h = 50 m: 113.0352013492 dB.
+        NS_TEST_EXPECT_MSG_EQ_TOL(loss->CalcRxPower(0.0, bs, ue),
+                                  -113.0352013492,
+                                  0.1,
+                                  "UMa-AV NLOS at 50 m / 500 m");
+
+        loss->SetAttribute("Scenario", StringValue("UMi-AV"));
+        loss->SetChannelConditionModel(CreateObject<AlwaysLosChannelConditionModel>());
+        bs->SetPosition(Vector(0.0, 0.0, 10.0));
+        ue->SetPosition(Vector(500.0, 0.0, 100.0));
+        NS_TEST_EXPECT_MSG_EQ_TOL(loss->CalcRxPower(0.0, bs, ue),
+                                  -94.4208474616,
+                                  0.1,
+                                  "UMi-AV LOS at 100 m / 500 m");
+
+        loss->SetAttribute("Scenario", StringValue("RMa-AV"));
+        bs->SetPosition(Vector(0.0, 0.0, 35.0));
+        ue->SetPosition(Vector(500.0, 0.0, 50.0));
+        NS_TEST_EXPECT_MSG_EQ_TOL(loss->CalcRxPower(0.0, bs, ue),
+                                  -94.7179822032,
+                                  0.1,
+                                  "RMa-AV LOS at 50 m / 500 m");
+
+        // Above 300 m the height is clamped to 300 m and a warning is logged.
+        loss->SetAttribute("Scenario", StringValue("UMa-AV"));
+        bs->SetPosition(Vector(0.0, 0.0, 25.0));
+        ue->SetPosition(Vector(500.0, 0.0, 300.0));
+        double atMax = loss->CalcRxPower(0.0, bs, ue);
+        NS_TEST_EXPECT_MSG_EQ(loss->GetHeightClampCount(), 0, "300 m is inside the model");
+        ue->SetPosition(Vector(500.0, 0.0, 350.0));
+        double aboveMax = loss->CalcRxPower(0.0, bs, ue);
+        NS_TEST_EXPECT_MSG_EQ_TOL(aboveMax, atMax, 1e-6, "height above 300 m uses 300 m");
+        NS_TEST_EXPECT_MSG_GT(loss->GetHeightClampCount(), 0, "height clamp logs a warning");
+
+        // Below the UMa threshold the terrestrial UMa formula is used.
+        Ptr<ThreeGppUmaPropagationLossModel> uma = CreateObject<ThreeGppUmaPropagationLossModel>();
+        uma->SetAttribute("ShadowingEnabled", BooleanValue(false));
+        uma->SetAttribute("BuildingPenetrationLossesEnabled", BooleanValue(false));
+        uma->SetAttribute("Frequency", DoubleValue(2.0e9));
+        uma->SetChannelConditionModel(CreateObject<AlwaysLosChannelConditionModel>());
+        loss->SetChannelConditionModel(CreateObject<AlwaysLosChannelConditionModel>());
+        bs->SetPosition(Vector(0.0, 0.0, 25.0));
+        ue->SetPosition(Vector(100.0, 0.0, 1.5));
+        NS_TEST_EXPECT_MSG_EQ_TOL(loss->CalcRxPower(0.0, bs, ue),
+                                  uma->CalcRxPower(0.0, bs, ue),
+                                  0.05,
+                                  "UMa-AV below 22.5 m matches UMa");
+
+        Ptr<ThreeGppAerialChannelConditionModel> cond =
+            CreateObject<ThreeGppAerialChannelConditionModel>();
+        NS_TEST_EXPECT_MSG_EQ_TOL(cond->GetLosProbability(1000.0, 50.0),
+                                  0.7720518705,
+                                  1e-6,
+                                  "UMa-AV LOS probability at 50 m / 1000 m");
+        NS_TEST_EXPECT_MSG_EQ_TOL(cond->GetLosProbability(5000.0, 150.0),
+                                  1.0,
+                                  1e-9,
+                                  "UMa-AV is LOS above 100 m");
+        cond->SetAttribute("Scenario", StringValue("UMi-AV"));
+        NS_TEST_EXPECT_MSG_EQ_TOL(cond->GetLosProbability(500.0, 30.0),
+                                  0.2619728828,
+                                  1e-6,
+                                  "UMi-AV LOS probability at 30 m / 500 m");
+        double umiAt300 = cond->GetLosProbability(800.0, 300.0);
+        double umiAbove = cond->GetLosProbability(800.0, 350.0);
+        NS_TEST_EXPECT_MSG_EQ_TOL(umiAbove, umiAt300, 1e-9, "UMi-AV LOS clamps height to 300 m");
+        NS_TEST_EXPECT_MSG_GT(cond->GetHeightClampCount(), 0, "LOS model logs the height clamp");
+        cond->SetAttribute("Scenario", StringValue("RMa-AV"));
+        NS_TEST_EXPECT_MSG_EQ_TOL(cond->GetLosProbability(2000.0, 20.0),
+                                  0.5976747604,
+                                  1e-6,
+                                  "RMa-AV LOS probability at 20 m / 2000 m");
+        NS_TEST_EXPECT_MSG_EQ_TOL(cond->GetLosProbability(5000.0, 80.0),
+                                  1.0,
+                                  1e-9,
+                                  "RMa-AV is LOS above 40 m");
+
+        Simulator::Destroy();
+    }
+};
+
+class ThreeGppAerialPropagationLossTestSuite : public TestSuite
+{
+  public:
+    ThreeGppAerialPropagationLossTestSuite()
+        : TestSuite("three-gpp-aerial-propagation-loss-model", Type::UNIT)
+    {
+        AddTestCase(new ThreeGppAerialPropagationLossTestCase, TestCase::Duration::QUICK);
+    }
+};
+
+static ThreeGppAerialPropagationLossTestSuite g_threeGppAerialPropagationLossTestSuite;
