+/*
+ * Copyright (c) 2026 CORNET
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * TR 36.777 V15.0.0 Annex B path loss and LOS probability for aerial UEs.
+ * Scope is path loss and LOS only. Fast fading stays the terrestrial model.
+ */
+
+#ifndef THREE_GPP_AERIAL_PROPAGATION_LOSS_MODEL_H
+#define THREE_GPP_AERIAL_PROPAGATION_LOSS_MODEL_H
+
+#include "three-gpp-propagation-loss-model.h"
+
+namespace ns3
+{
+
+/**
+ * LOS probability for UMa-AV, UMi-AV, and RMa-AV (TR 36.777 Table B-1).
+ *
+ * Below the scenario height threshold the terrestrial TR 38.901 probability is
+ * used. Above the maximum height of 300 m the height is clamped and a warning
+ * is logged.
+ */
+class ThreeGppAerialChannelConditionModel : public ThreeGppChannelConditionModel
+{
+  public:
+    enum Scenario
+    {
+        UMa_AV,
+        UMi_AV,
+        RMa_AV
+    };
+
+    static TypeId GetTypeId();
+
+    ThreeGppAerialChannelConditionModel();
+    ~ThreeGppAerialChannelConditionModel() override;
+
+    void SetScenario(Scenario scenario);
+    Scenario GetScenario() const;
+
+    /**
+     * LOS probability for a 2D distance and UT height.
+     *
+     * Heights outside 1.5 m..300 m are clamped. Each clamp increments
+     * GetHeightClampCount() and logs a warning.
+     */
+    double GetLosProbability(double d2dMeters, double hUtMeters) const;
+
+    uint32_t GetHeightClampCount() const;
+
+  private:
+    double ComputePlos(Ptr<const MobilityModel> a, Ptr<const MobilityModel> b) const override;
+
+    Scenario m_scenario;
+    mutable uint32_t m_heightClampCount;
+};
+
+/**
+ * Path loss for UMa-AV, UMi-AV, and RMa-AV (TR 36.777 Tables B-2 and B-3).
+ *
+ * Below the scenario height threshold the loss is delegated to the terrestrial
+ * UMa, UMi-Street Canyon, or RMa model. Above 300 m the UT height is clamped
+ * and a warning is logged. Building penetration is left off: the scope is
+ * aerial path loss only.
+ */
+class ThreeGppAerialPropagationLossModel : public ThreeGppPropagationLossModel
+{
+  public:
+    using Scenario = ThreeGppAerialChannelConditionModel::Scenario;
+
+    static TypeId GetTypeId();
+
+    ThreeGppAerialPropagationLossModel();
+    ~ThreeGppAerialPropagationLossModel() override;
+
+    void SetScenario(Scenario scenario);
+    Scenario GetScenario() const;
+
+    uint32_t GetHeightClampCount() const;
+
+  private:
+    struct Geometry
+    {
+        double d2d;
+        double d3d;
+        double hBs;
+        double hUt;
+    };
+
+    double GetLossLos(Ptr<MobilityModel> a, Ptr<MobilityModel> b) const override;
+    double GetLossNlos(Ptr<MobilityModel> a, Ptr<MobilityModel> b) const override;
+    double GetShadowingStd(Ptr<MobilityModel> a,
+                           Ptr<MobilityModel> b,
+                           ChannelCondition::LosConditionValue cond) const override;
+    double GetShadowingCorrelationDistance(
+        ChannelCondition::LosConditionValue cond) const override;
+    double GetO2iDistance2dIn() const override;
+
+    Geometry MakeGeometry(Ptr<MobilityModel> a, Ptr<MobilityModel> b) const;
+    double TerrestrialLoss(bool los, Ptr<MobilityModel> a, Ptr<MobilityModel> b) const;
+    double LosDb(const Geometry& link, double fcGHz) const;
+    double NlosDb(const Geometry& link, double fcGHz) const;
+    double NominalBsHeight() const;
+    double LowHeightMax() const;
+
+    Scenario m_scenario;
+    Ptr<ThreeGppPropagationLossModel> m_low;
+    Ptr<ChannelConditionModel> m_alwaysLos;
+    Ptr<ChannelConditionModel> m_neverLos;
+    mutable uint32_t m_heightClampCount;
+};
+
+} // namespace ns3
+
+#endif // THREE_GPP_AERIAL_PROPAGATION_LOSS_MODEL_H
