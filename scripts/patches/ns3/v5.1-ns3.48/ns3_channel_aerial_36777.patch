+#include "three-gpp-aerial-propagation-loss-model.h"
+
+#include "ns3/boolean.h"
+#include "ns3/double.h"
+#include "ns3/enum.h"
+#include "ns3/log.h"
+#include "ns3/mobility-model.h"
+
+#include <algorithm>
+#include <cmath>
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+namespace ns3
+{
+
+NS_LOG_COMPONENT_DEFINE("ThreeGppAerialPropagationLossModel");
+
+namespace
+{
+
+double
+PiecewiseLos(double d2d, double d1, double p1)
+{
+    if (d2d <= d1)
+    {
+        return 1.0;
+    }
+    if (p1 <= 0.0)
+    {
+        p1 = 1.0;
+    }
+    double p = d1 / d2d + std::exp(-d2d / p1) * (1.0 - d1 / d2d);
+    return std::min(1.0, std::max(0.0, p));
+}
+
+double
+UmaTerrestrialLos(double d2d, double hUt)
+{
+    if (d2d <= 18.0)
+    {
+        return 1.0;
+    }
+    double c = 0.0;
+    if (hUt > 13.0)
+    {
+        c = std::pow((hUt - 13.0) / 10.0, 1.5);
+    }
+    double base = 18.0 / d2d + std::exp(-d2d / 63.0) * (1.0 - 18.0 / d2d);
+    return base * (1.0 + c * 1.25 * std::pow(d2d / 100.0, 3.0) * std::exp(-d2d / 150.0));
+}
+
+double
+UmiTerrestrialLos(double d2d)
+{
+    if (d2d <= 18.0)
+    {
+        return 1.0;
+    }
+    return 18.0 / d2d + std::exp(-d2d / 36.0) * (1.0 - 18.0 / d2d);
+}
+
+double
+RmaTerrestrialLos(double d2d)
+{
+    if (d2d <= 10.0)
+    {
+        return 1.0;
+    }
+    return std::exp(-(d2d - 10.0) / 1000.0);
+}
+
+double
+FreeSpaceTermDb(double fcGHz)
+{
+    return 20.0 * std::log10(40.0 * M_PI * fcGHz / 3.0);
+}
+
+} // namespace
+
+NS_OBJECT_ENSURE_REGISTERED(ThreeGppAerialChannelConditionModel);
+
+TypeId
+ThreeGppAerialChannelConditionModel::GetTypeId()
+{
+    static TypeId tid =
+        TypeId("ns3::ThreeGppAerialChannelConditionModel")
+            .SetParent<ThreeGppChannelConditionModel>()
+            .SetGroupName("Propagation")
+            .AddConstructor<ThreeGppAerialChannelConditionModel>()
+            .AddAttribute("Scenario",
+                          "TR 36.777 aerial scenario.",
+                          EnumValue(ThreeGppAerialChannelConditionModel::UMa_AV),
+                          MakeEnumAccessor<ThreeGppAerialChannelConditionModel::Scenario>(
+                              &ThreeGppAerialChannelConditionModel::SetScenario,
+                              &ThreeGppAerialChannelConditionModel::GetScenario),
+                          MakeEnumChecker(ThreeGppAerialChannelConditionModel::UMa_AV,
+                                          "UMa-AV",
+                                          ThreeGppAerialChannelConditionModel::UMi_AV,
+                                          "UMi-AV",
+                                          ThreeGppAerialChannelConditionModel::RMa_AV,
+                                          "RMa-AV"));
+    return tid;
+}
+
+ThreeGppAerialChannelConditionModel::ThreeGppAerialChannelConditionModel()
+    : ThreeGppChannelConditionModel(),
+      m_scenario(UMa_AV),
+      m_heightClampCount(0)
+{
+    NS_LOG_FUNCTION(this);
+}
+
+ThreeGppAerialChannelConditionModel::~ThreeGppAerialChannelConditionModel()
+{
+    NS_LOG_FUNCTION(this);
+}
+
+void
+ThreeGppAerialChannelConditionModel::SetScenario(Scenario scenario)
+{
+    m_scenario = scenario;
+}
+
+ThreeGppAerialChannelConditionModel::Scenario
+ThreeGppAerialChannelConditionModel::GetScenario() const
+{
+    return m_scenario;
+}
+
+uint32_t
+ThreeGppAerialChannelConditionModel::GetHeightClampCount() const
+{
+    return m_heightClampCount;
+}
+
+double
+ThreeGppAerialChannelConditionModel::GetLosProbability(double d2d, double hUt) const
+{
+    if (hUt > 300.0)
+    {
+        NS_LOG_WARN("TR 36.777 aerial UT height " << hUt
+                                                   << " m exceeds 300 m; clamping to 300 m");
+        ++m_heightClampCount;
+        hUt = 300.0;
+    }
+    else if (hUt < 1.5)
+    {
+        NS_LOG_WARN("TR 36.777 aerial UT height " << hUt
+                                                   << " m is below 1.5 m; clamping to 1.5 m");
+        ++m_heightClampCount;
+        hUt = 1.5;
+    }
+
+    switch (m_scenario)
+    {
+    case UMa_AV:
+        if (hUt <= 22.5)
+        {
+            return UmaTerrestrialLos(d2d, hUt);
+        }
+        if (hUt > 100.0)
+        {
+            return 1.0;
+        }
+        return PiecewiseLos(d2d,
+                            std::max(460.0 * std::log10(hUt) - 700.0, 18.0),
+                            4300.0 * std::log10(hUt) - 3800.0);
+    case UMi_AV:
+        if (hUt <= 22.5)
+        {
+            return UmiTerrestrialLos(d2d);
+        }
+        return PiecewiseLos(d2d,
+                            std::max(294.05 * std::log10(hUt) - 432.94, 18.0),
+                            233.98 * std::log10(hUt) - 0.95);
+    case RMa_AV:
+        if (hUt <= 10.0)
+        {
+            return RmaTerrestrialLos(d2d);
+        }
+        if (hUt > 40.0)
+        {
+            return 1.0;
+        }
+        return PiecewiseLos(d2d,
+                            std::max(1350.8 * std::log10(hUt) - 1602.0, 18.0),
+                            std::max(15021.0 * std::log10(hUt) - 16053.0, 1000.0));
+    }
+    return 1.0;
+}
+
+double
+ThreeGppAerialChannelConditionModel::ComputePlos(Ptr<const MobilityModel> a,
+                                                 Ptr<const MobilityModel> b) const
+{
+    Vector pa = a->GetPosition();
+    Vector pb = b->GetPosition();
+    double d2d = std::hypot(pa.x - pb.x, pa.y - pb.y);
+    double bs = 25.0;
+    if (m_scenario == UMi_AV)
+    {
+        bs = 10.0;
+    }
+    else if (m_scenario == RMa_AV)
+    {
+        bs = 35.0;
+    }
+    double hUt = pb.z;
+    double hBs = pa.z;
+    if (std::abs(pb.z - bs) < std::abs(pa.z - bs))
+    {
+        hUt = pa.z;
+        hBs = pb.z;
+    }
+    if (std::abs(hBs - bs) > 0.5)
+    {
+        NS_LOG_WARN("TR 36.777 LOS probability assumes a BS height of " << bs << " m");
+    }
+    return GetLosProbability(d2d, hUt);
+}
+
+NS_OBJECT_ENSURE_REGISTERED(ThreeGppAerialPropagationLossModel);
+
+TypeId
+ThreeGppAerialPropagationLossModel::GetTypeId()
+{
+    static TypeId tid =
+        TypeId("ns3::ThreeGppAerialPropagationLossModel")
+            .SetParent<ThreeGppPropagationLossModel>()
+            .SetGroupName("Propagation")
+            .AddConstructor<ThreeGppAerialPropagationLossModel>()
+            .AddAttribute("Scenario",
+                          "TR 36.777 aerial scenario.",
+                          EnumValue(ThreeGppAerialChannelConditionModel::UMa_AV),
+                          MakeEnumAccessor<Scenario>(&ThreeGppAerialPropagationLossModel::SetScenario,
+                                                     &ThreeGppAerialPropagationLossModel::GetScenario),
+                          MakeEnumChecker(ThreeGppAerialChannelConditionModel::UMa_AV,
+                                          "UMa-AV",
+                                          ThreeGppAerialChannelConditionModel::UMi_AV,
+                                          "UMi-AV",
+                                          ThreeGppAerialChannelConditionModel::RMa_AV,
+                                          "RMa-AV"));
+    return tid;
+}
+
+ThreeGppAerialPropagationLossModel::ThreeGppAerialPropagationLossModel()
+    : ThreeGppPropagationLossModel(),
+      m_scenario(ThreeGppAerialChannelConditionModel::UMa_AV),
+      m_heightClampCount(0)
+{
+    NS_LOG_FUNCTION(this);
+    m_buildingPenLossesEnabled = false;
+    m_frequency = 2.0e9;
+    m_alwaysLos = CreateObject<AlwaysLosChannelConditionModel>();
+    m_neverLos = CreateObject<NeverLosChannelConditionModel>();
+    m_channelConditionModel = CreateObject<ThreeGppAerialChannelConditionModel>();
+    SetScenario(ThreeGppAerialChannelConditionModel::UMa_AV);
+}
+
+ThreeGppAerialPropagationLossModel::~ThreeGppAerialPropagationLossModel()
+{
+    NS_LOG_FUNCTION(this);
+}
+
+void
+ThreeGppAerialPropagationLossModel::SetScenario(Scenario scenario)
+{
+    NS_LOG_FUNCTION(this << scenario);
+    m_scenario = scenario;
+    switch (scenario)
+    {
+    case ThreeGppAerialChannelConditionModel::UMi_AV:
+        m_low = CreateObject<ThreeGppUmiStreetCanyonPropagationLossModel>();
+        break;
+    case ThreeGppAerialChannelConditionModel::RMa_AV:
+        m_low = CreateObject<ThreeGppRmaPropagationLossModel>();
+        break;
+    case ThreeGppAerialChannelConditionModel::UMa_AV:
+    default:
+        m_low = CreateObject<ThreeGppUmaPropagationLossModel>();
+        break;
+    }
+    m_low->SetAttribute("ShadowingEnabled", BooleanValue(false));
+    m_low->SetAttribute("BuildingPenetrationLossesEnabled", BooleanValue(false));
+    Ptr<ThreeGppAerialChannelConditionModel> aerial =
+        DynamicCast<ThreeGppAerialChannelConditionModel>(m_channelConditionModel);
+    if (aerial)
+    {
+        aerial->SetScenario(scenario);
+    }
+}
+
+ThreeGppAerialPropagationLossModel::Scenario
+ThreeGppAerialPropagationLossModel::GetScenario() const
+{
+    return m_scenario;
+}
+
+uint32_t
+ThreeGppAerialPropagationLossModel::GetHeightClampCount() const
+{
+    return m_heightClampCount;
+}
+
+double
+ThreeGppAerialPropagationLossModel::NominalBsHeight() const
+{
+    switch (m_scenario)
+    {
+    case ThreeGppAerialChannelConditionModel::UMi_AV:
+        return 10.0;
+    case ThreeGppAerialChannelConditionModel::RMa_AV:
+        return 35.0;
+    case ThreeGppAerialChannelConditionModel::UMa_AV:
+    default:
+        return 25.0;
+    }
+}
+
+double
+ThreeGppAerialPropagationLossModel::LowHeightMax() const
+{
+    return m_scenario == ThreeGppAerialChannelConditionModel::RMa_AV ? 10.0 : 22.5;
+}
+
+ThreeGppAerialPropagationLossModel::Geometry
+ThreeGppAerialPropagationLossModel::MakeGeometry(Ptr<MobilityModel> a, Ptr<MobilityModel> b) const
+{
+    Vector pa = a->GetPosition();
+    Vector pb = b->GetPosition();
+    Geometry link;
+    link.d2d = std::hypot(pa.x - pb.x, pa.y - pb.y);
+    double bs = NominalBsHeight();
+    link.hUt = pb.z;
+    link.hBs = pa.z;
+    if (std::abs(pb.z - bs) < std::abs(pa.z - bs))
+    {
+        link.hUt = pa.z;
+        link.hBs = pb.z;
+    }
+    if (std::abs(link.hBs - bs) > 0.5)
+    {
+        NS_LOG_WARN("TR 36.777 path loss assumes a BS height of " << bs << " m");
+    }
+    if (link.hUt > 300.0)
+    {
+        NS_LOG_WARN("TR 36.777 aerial UT height " << link.hUt
+                                                   << " m exceeds 300 m; clamping to 300 m");
+        ++m_heightClampCount;
+        link.hUt = 300.0;
+    }
+    else if (link.hUt < 1.5)
+    {
+        NS_LOG_WARN("TR 36.777 aerial UT height " << link.hUt
+                                                   << " m is below 1.5 m; clamping to 1.5 m");
+        ++m_heightClampCount;
+        link.hUt = 1.5;
+    }
+    link.d3d = std::hypot(link.d2d, link.hBs - link.hUt);
+    if (link.d3d < 1.0)
+    {
+        link.d3d = 1.0;
+    }
+    double maxD2d = m_scenario == ThreeGppAerialChannelConditionModel::RMa_AV ? 10000.0 : 4000.0;
+    if (link.d2d > maxD2d)
+    {
+        NS_LOG_WARN("TR 36.777 2D distance is outside the aerial applicability range");
+    }
+    return link;
+}
+
+double
+ThreeGppAerialPropagationLossModel::TerrestrialLoss(bool los,
+                                                    Ptr<MobilityModel> a,
+                                                    Ptr<MobilityModel> b) const
+{
+    m_low->SetFrequency(m_frequency);
+    m_low->SetChannelConditionModel(los ? m_alwaysLos : m_neverLos);
+    return -m_low->CalcRxPower(0.0, a, b);
+}
+
+double
+ThreeGppAerialPropagationLossModel::LosDb(const Geometry& link, double fcGHz) const
+{
+    double d3 = link.d3d;
+    double h = link.hUt;
+    switch (m_scenario)
+    {
+    case ThreeGppAerialChannelConditionModel::UMa_AV:
+        return 28.0 + 22.0 * std::log10(d3) + 20.0 * std::log10(fcGHz);
+    case ThreeGppAerialChannelConditionModel::UMi_AV: {
+        double formula =
+            30.9 + (22.25 - 0.5 * std::log10(h)) * std::log10(d3) + 20.0 * std::log10(fcGHz);
+        double freeSpace = 20.0 * std::log10(d3) + FreeSpaceTermDb(fcGHz);
+        return std::max(freeSpace, formula);
+    }
+    case ThreeGppAerialChannelConditionModel::RMa_AV: {
+        double slope = std::max(23.9 - 1.8 * std::log10(h), 20.0);
+        return slope * std::log10(d3) + FreeSpaceTermDb(fcGHz);
+    }
+    }
+    return 0.0;
+}
+
+double
+ThreeGppAerialPropagationLossModel::NlosDb(const Geometry& link, double fcGHz) const
+{
+    double d3 = link.d3d;
+    double h = link.hUt;
+    double los = LosDb(link, fcGHz);
+    switch (m_scenario)
+    {
+    case ThreeGppAerialChannelConditionModel::UMa_AV:
+        if (h > 100.0)
+        {
+            NS_LOG_WARN("UMa-AV NLOS path loss is specified only up to 100 m; using 100 m");
+            h = 100.0;
+        }
+        return -17.5 + (46.0 - 7.0 * std::log10(h)) * std::log10(d3) + FreeSpaceTermDb(fcGHz);
+    case ThreeGppAerialChannelConditionModel::UMi_AV: {
+        double nlos =
+            32.4 + (43.2 - 7.6 * std::log10(h)) * std::log10(d3) + 20.0 * std::log10(fcGHz);
+        return std::max(los, nlos);
+    }
+    case ThreeGppAerialChannelConditionModel::RMa_AV: {
+        double nlos = -12.0 + (35.0 - 5.3 * std::log10(h)) * std::log10(d3) + FreeSpaceTermDb(fcGHz);
+        return std::max(los, nlos);
+    }
+    }
+    return los;
+}
+
+double
+ThreeGppAerialPropagationLossModel::GetLossLos(Ptr<MobilityModel> a, Ptr<MobilityModel> b) const
+{
+    NS_LOG_FUNCTION(this);
+    NS_ASSERT_MSG(m_frequency > 0.0, "First set the centre frequency");
+    Geometry link = MakeGeometry(a, b);
+    if (link.hUt <= LowHeightMax())
+    {
+        return TerrestrialLoss(true, a, b);
+    }
+    return LosDb(link, m_frequency / 1.0e9);
+}
+
+double
+ThreeGppAerialPropagationLossModel::GetLossNlos(Ptr<MobilityModel> a, Ptr<MobilityModel> b) const
+{
+    NS_LOG_FUNCTION(this);
+    NS_ASSERT_MSG(m_frequency > 0.0, "First set the centre frequency");
+    Geometry link = MakeGeometry(a, b);
+    if (link.hUt <= LowHeightMax())
+    {
+        return TerrestrialLoss(false, a, b);
+    }
+    return NlosDb(link, m_frequency / 1.0e9);
+}
+
+double
+ThreeGppAerialPropagationLossModel::GetShadowingStd(
+    Ptr<MobilityModel> a,
+    Ptr<MobilityModel> b,
+    ChannelCondition::LosConditionValue cond) const
+{
+    Geometry link = MakeGeometry(a, b);
+    bool los = cond == ChannelCondition::LosConditionValue::LOS;
+    if (link.hUt <= LowHeightMax())
+    {
+        if (m_scenario == ThreeGppAerialChannelConditionModel::RMa_AV)
+        {
+            return los ? 4.0 : 8.0;
+        }
+        if (m_frequency < 6.0e9)
+        {
+            return 7.0;
+        }
+        if (m_scenario == ThreeGppAerialChannelConditionModel::UMi_AV)
+        {
+            return los ? 4.0 : 7.82;
+        }
+        return los ? 4.0 : 6.0;
+    }
+    switch (m_scenario)
+    {
+    case ThreeGppAerialChannelConditionModel::UMa_AV:
+        return los ? 4.64 * std::exp(-0.0066 * link.hUt) : 6.0;
+    case ThreeGppAerialChannelConditionModel::UMi_AV:
+        return los ? std::max(5.0 * std::exp(-0.01 * link.hUt), 2.0) : 8.0;
+    case ThreeGppAerialChannelConditionModel::RMa_AV:
+        return los ? 4.2 * std::exp(-0.0046 * link.hUt) : 6.0;
+    }
+    return 6.0;
+}
+
+double
+ThreeGppAerialPropagationLossModel::GetShadowingCorrelationDistance(
+    ChannelCondition::LosConditionValue cond) const
+{
+    // This hook has no UT height, so the distance follows TR 38.901.
+    // Table B-3's 25 m aerial recalculation is outside this method.
+    if (cond == ChannelCondition::LosConditionValue::LOS)
+    {
+        if (m_scenario == ThreeGppAerialChannelConditionModel::UMi_AV)
+        {
+            return 10.0;
+        }
+        return 37.0;
+    }
+    if (m_scenario == ThreeGppAerialChannelConditionModel::UMi_AV)
+    {
+        return 13.0;
+    }
+    if (m_scenario == ThreeGppAerialChannelConditionModel::RMa_AV)
+    {
+        return 120.0;
+    }
+    return 50.0;
+}
+
+double
+ThreeGppAerialPropagationLossModel::GetO2iDistance2dIn() const
+{
+    return 0.0;
+}
+
+} // namespace ns3
