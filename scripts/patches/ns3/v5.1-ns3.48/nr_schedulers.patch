diff --git a/model/nr-mac-scheduler-ue-info-aoi.h b/model/nr-mac-scheduler-ue-info-aoi.h
new file mode 100644
index 0000000..6b41762
--- /dev/null
+++ b/model/nr-mac-scheduler-ue-info-aoi.h
@@ -0,0 +1,88 @@
+// Copyright (c) 2026
+//
+// SPDX-License-Identifier: GPL-2.0-only
+
+#pragma once
+
+#include "nr-mac-scheduler-ue-info-edf.h"
+
+#include "ns3/nr-export.h"
+
+#include "ns3/simulator.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace ns3
+{
+
+/**
+ * @ingroup scheduler
+ * @brief Per-UE state for the AoI-aware scheduler.
+ *
+ * weight = max(urgency, ε) × (β × age_ms + PF)
+ */
+class NR_EXPORT NrMacSchedulerUeInfoAoi : public NrMacSchedulerUeInfoEdf
+{
+  public:
+    NrMacSchedulerUeInfoAoi(float alpha,
+                            double aoiBeta,
+                            uint16_t rnti,
+                            BeamId beamId,
+                            const GetRbPerRbgFn& fn)
+        : NrMacSchedulerUeInfoEdf(alpha, rnti, beamId, fn),
+          m_aoiBeta(aoiBeta)
+    {
+    }
+
+    void OnDlTransmission()
+    {
+        m_lastTxTime = Simulator::Now();
+        m_aoiMs = 0.0;
+    }
+
+    double GetAoiMs() const
+    {
+        return (Simulator::Now() - m_lastTxTime).GetMilliSeconds();
+    }
+
+    static bool CompareUeWeightsDl(const NrMacSchedulerNs3::UePtrAndBufferReq& lue,
+                                   const NrMacSchedulerNs3::UePtrAndBufferReq& rue)
+    {
+        return CalculateDlWeightAoi(lue) > CalculateDlWeightAoi(rue);
+    }
+
+    static double CalculateDlWeightAoi(const NrMacSchedulerNs3::UePtrAndBufferReq& ue)
+    {
+        auto uePtr = dynamic_cast<NrMacSchedulerUeInfoAoi*>(ue.first.get());
+        double urgencyWeight = 0.0;
+        for (const auto& ueLcg : ue.first->m_dlLCG)
+        {
+            for (const auto lcId : ueLcg.second->GetLCId())
+            {
+                if (ueLcg.second->GetTotalSizeOfLC(lcId) == 0)
+                {
+                    continue;
+                }
+                const NrMacSchedulerLC* lc = ueLcg.second->GetLC(lcId).get();
+                const double delayBudgetMs = static_cast<double>(lc->m_delayBudget.GetMilliSeconds());
+                const double holDelayMs = static_cast<double>(lc->m_rlcTransmissionQueueHolDelay);
+                const double remainingBudget = std::max(0.1, delayBudgetMs - holDelayMs);
+                const double delayUrgency = delayBudgetMs > 0.0 ? (delayBudgetMs / remainingBudget)
+                                                                : (1.0 / remainingBudget);
+                urgencyWeight += delayUrgency * (1.0 / std::max(1E-9, lc->m_PER));
+            }
+        }
+
+        const double aoiFactor = uePtr->m_aoiBeta * uePtr->GetAoiMs();
+        const double pfFactor = std::pow(std::max(1E-9, uePtr->m_potentialTputDl), uePtr->m_alpha) /
+                                std::max(1E-9, uePtr->m_avgTputDl);
+        return std::max(1E-9, urgencyWeight) * (aoiFactor + std::max(1.0, pfFactor));
+    }
+
+    Time m_lastTxTime{};
+    double m_aoiMs{0.0};
+    double m_aoiBeta{0.01};
+};
+
+} // namespace ns3
