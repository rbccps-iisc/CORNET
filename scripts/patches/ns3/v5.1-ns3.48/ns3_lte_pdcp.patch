+void
+LtePdcp::SendRepetition(Ptr<Packet> p)
+{
+    NS_LOG_FUNCTION(this << m_rnti << static_cast<uint16_t>(m_lcid) << p->GetSize());
+    LteRlcSapProvider::TransmitPdcpPduParameters txParams;
+    txParams.rnti = m_rnti;
+    txParams.lcid = m_lcid;
+    txParams.pdcpPdu = p;
