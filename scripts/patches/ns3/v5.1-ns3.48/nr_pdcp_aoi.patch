+void
+NrPdcp::SendRepetition(Ptr<Packet> p)
+{
+    NS_LOG_FUNCTION(this << m_rnti << static_cast<uint16_t>(m_lcid) << p->GetSize());
+    NrRlcSapProvider::TransmitPdcpPduParameters txParams;
+    txParams.rnti = m_rnti;
