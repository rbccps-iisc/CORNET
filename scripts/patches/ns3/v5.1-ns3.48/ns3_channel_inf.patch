+NS_OBJECT_ENSURE_REGISTERED(ThreeGppInfPropagationLossModel);
+
+TypeId
+ThreeGppInfPropagationLossModel::GetTypeId()
+{
+    static TypeId tid =
+        TypeId("ns3::ThreeGppInfPropagationLossModel")
+            .SetParent<ThreeGppPropagationLossModel>()
+            .SetGroupName("Propagation")
+            .AddConstructor<ThreeGppInfPropagationLossModel>()
+            .AddAttribute("SubScenario",
+                          "Indoor Factory sub-scenario (TR 38.901 Table 7.4.1-1).",
+                          EnumValue(ThreeGppInfPropagationLossModel::SL),
+                          MakeEnumAccessor<ThreeGppInfPropagationLossModel::SubScenario>(
+                              &ThreeGppInfPropagationLossModel::m_subScenario),
+                          MakeEnumChecker(ThreeGppInfPropagationLossModel::SL,
+                                          "SL",
+                                          ThreeGppInfPropagationLossModel::DL,
+                                          "DL",
+                                          ThreeGppInfPropagationLossModel::SH,
+                                          "SH",
+                                          ThreeGppInfPropagationLossModel::DH,
+                                          "DH"));
+    return tid;
+}
+
+ThreeGppInfPropagationLossModel::ThreeGppInfPropagationLossModel()
+    : ThreeGppPropagationLossModel()
+{
+    NS_LOG_FUNCTION(this);
+    m_channelConditionModel = CreateObject<ThreeGppInfChannelConditionModel>();
+}
+
+ThreeGppInfPropagationLossModel::~ThreeGppInfPropagationLossModel()
+{
+    NS_LOG_FUNCTION(this);
+}
+
+double
+ThreeGppInfPropagationLossModel::GetO2iDistance2dIn() const
+{
+    return 0;
+}
+
+void
+ThreeGppInfPropagationLossModel::WarnIfOutOfRange(double distance3D) const
+{
+    if (distance3D < 1.0 || distance3D > 600.0)
+    {
+        NS_ABORT_MSG_IF(m_enforceRanges, "InF 3D distance out of range");
+        NS_LOG_WARN("InF 3D distance is outside 1..600 m; the path loss may not be accurate");
+    }
+}
+
+double
+ThreeGppInfPropagationLossModel::PlLos(double distance3D) const
+{
+    // TR 38.901 Table 7.4.1-1, InF LOS.
+    const double fcGHz = m_frequency / 1e9;
+    return 31.84 + 21.50 * log10(distance3D) + 19.00 * log10(fcGHz);
+}
+
+double
+ThreeGppInfPropagationLossModel::GetLossLos(Ptr<MobilityModel> a, Ptr<MobilityModel> b) const
+{
+    NS_LOG_FUNCTION(this);
+    const double distance3D = CalculateDistance(a->GetPosition(), b->GetPosition());
+    WarnIfOutOfRange(distance3D);
+    const double loss = PlLos(distance3D);
+    NS_LOG_DEBUG("Loss " << loss);
+    return loss;
+}
+
+double
+ThreeGppInfPropagationLossModel::GetLossNlos(Ptr<MobilityModel> a, Ptr<MobilityModel> b) const
+{
+    NS_LOG_FUNCTION(this);
+    const double distance3D = CalculateDistance(a->GetPosition(), b->GetPosition());
+    WarnIfOutOfRange(distance3D);
+    const double fcGHz = m_frequency / 1e9;
+    const double plLos = PlLos(distance3D);
+    double pl = 0.0;
+    switch (m_subScenario)
+    {
+    case SL:
+        pl = 33.0 + 25.5 * log10(distance3D) + 20.0 * log10(fcGHz);
+        pl = std::max(pl, plLos);
+        break;
+    case DL: {
+        const double plSl = 33.0 + 25.5 * log10(distance3D) + 20.0 * log10(fcGHz);
+        pl = 18.6 + 35.7 * log10(distance3D) + 20.0 * log10(fcGHz);
+        pl = std::max(pl, std::max(plLos, plSl));
+        break;
+    }
+    case SH:
+        pl = 32.4 + 23.0 * log10(distance3D) + 20.0 * log10(fcGHz);
+        pl = std::max(pl, plLos);
+        break;
+    case DH:
+        pl = 33.63 + 21.9 * log10(distance3D) + 20.0 * log10(fcGHz);
+        pl = std::max(pl, plLos);
+        break;
+    }
+    NS_LOG_DEBUG("Loss " << pl);
+    return pl;
+}
+
+double
+ThreeGppInfPropagationLossModel::GetShadowingStd(Ptr<MobilityModel> /* a */,
+                                                 Ptr<MobilityModel> /* b */,
+                                                 ChannelCondition::LosConditionValue cond) const
+{
+    NS_LOG_FUNCTION(this);
+    if (cond == ChannelCondition::LosConditionValue::LOS)
+    {
+        return 4.3;
+    }
+    if (cond != ChannelCondition::LosConditionValue::NLOS)
+    {
+        NS_FATAL_ERROR("Unknown channel condition");
+    }
+    switch (m_subScenario)
+    {
+    case SL:
+        return 5.7;
+    case DL:
+        return 7.2;
+    case SH:
+        return 5.9;
+    case DH:
+        return 4.0;
+    }
+    return 4.3;
+}
+
+double
+ThreeGppInfPropagationLossModel::GetShadowingCorrelationDistance(
+    ChannelCondition::LosConditionValue cond) const
+{
+    NS_LOG_FUNCTION(this);
+    // TR 38.901 Table 7.5-6 Part-3: 10 m for every InF large-scale parameter.
+    if (cond != ChannelCondition::LosConditionValue::LOS &&
+        cond != ChannelCondition::LosConditionValue::NLOS)
+    {
+        NS_FATAL_ERROR("Unknown channel condition");
+    }
+    return 10.0;
+}
+
 } // namespace ns3
