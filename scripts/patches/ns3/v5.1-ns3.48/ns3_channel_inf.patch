+
+    ThreeGppInfPropagationLossModel(const ThreeGppInfPropagationLossModel&) = delete;
+    ThreeGppInfPropagationLossModel& operator=(const ThreeGppInfPropagationLossModel&) = delete;
+
+  private:
+    double GetLossLos(Ptr<MobilityModel> a, Ptr<MobilityModel> b) const override;
+    double GetLossNlos(Ptr<MobilityModel> a, Ptr<MobilityModel> b) const override;
+    double GetShadowingStd(Ptr<MobilityModel> a,
+                           Ptr<MobilityModel> b,
+                           ChannelCondition::LosConditionValue cond) const override;
+    double GetShadowingCorrelationDistance(ChannelCondition::LosConditionValue cond) const override;
+    double GetO2iDistance2dIn() const override;
+
+    double PlLos(double distance3D) const;
+    void WarnIfOutOfRange(double distance3D) const;
+
+    SubScenario m_subScenario{SL};
+};
+
