+TypeId
+ThreeGppInfChannelConditionModel::GetTypeId()
+{
+    static TypeId tid =
+        TypeId("ns3::ThreeGppInfChannelConditionModel")
+            .SetParent<ThreeGppChannelConditionModel>()
+            .SetGroupName("Propagation")
+            .AddConstructor<ThreeGppInfChannelConditionModel>()
+            .AddAttribute("ClutterDensity",
+                          "Fraction of floor area occupied by clutter, r in (0, 1). "
+                          "TR 38.901 Table 7.2-4.",
+                          DoubleValue(0.2),
+                          MakeDoubleAccessor(&ThreeGppInfChannelConditionModel::m_clutterDensity),
+                          MakeDoubleChecker<double>(1e-6, 0.999))
+            .AddAttribute("ClutterSize",
+                          "Typical clutter size d_clutter in metres.",
+                          DoubleValue(10.0),
+                          MakeDoubleAccessor(&ThreeGppInfChannelConditionModel::m_clutterSize),
+                          MakeDoubleChecker<double>(0.1))
+            .AddAttribute("ClutterHeight",
+                          "Effective clutter height h_c in metres.",
+                          DoubleValue(2.0),
+                          MakeDoubleAccessor(&ThreeGppInfChannelConditionModel::m_clutterHeight),
+                          MakeDoubleChecker<double>(0.0))
+            .AddAttribute("BsAboveClutter",
+                          "True for InF-SH and InF-DH (BS above the clutter).",
+                          BooleanValue(false),
+                          MakeBooleanAccessor(&ThreeGppInfChannelConditionModel::m_bsAboveClutter),
+                          MakeBooleanChecker());
+    return tid;
+}
+
+ThreeGppInfChannelConditionModel::ThreeGppInfChannelConditionModel()
+    : ThreeGppChannelConditionModel()
+{
+}
+
+ThreeGppInfChannelConditionModel::~ThreeGppInfChannelConditionModel()
+{
+}
+
+double
+ThreeGppInfChannelConditionModel::ComputePlos(Ptr<const MobilityModel> a,
+                                              Ptr<const MobilityModel> b) const
+{
+    const double distance2D = Calculate2dDistance(a->GetPosition(), b->GetPosition());
+    // k = -d_clutter / ln(1 - r). High-BS multiplies by (h_BS - h_UT) / (h_c - h_UT).
+    double k = -m_clutterSize / std::log(1.0 - m_clutterDensity);
+    if (m_bsAboveClutter)
+    {
+        const double hBs = std::max(a->GetPosition().z, b->GetPosition().z);
+        const double hUt = std::min(a->GetPosition().z, b->GetPosition().z);
+        const double denom = m_clutterHeight - hUt;
+        if (denom <= 0.1)
+        {
+            NS_LOG_WARN("InF high-BS LOS formula needs h_c > h_UT; using the low-BS k");
+        }
+        else
+        {
+            k *= (hBs - hUt) / denom;
+        }
+    }
+    if (k < 1e-3)
+    {
+        k = 1e-3;
+    }
+    return std::exp(-distance2D / k);
+}
+
 } // namespace ns3
